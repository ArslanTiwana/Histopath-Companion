DATABASE_URL=postgresql://postgres:postgres@localhost:5432/histopath

# AI provider configuration. GROQ_API_KEY stays server-side.
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL_STT=whisper-large-v3-turbo
AI_MODEL_COMMANDS=openai/gpt-oss-20b
# Optional fallback used once when the command model returns an invalid tool call.
AI_MODEL_COMMANDS_FALLBACK=
AI_MODEL_CHAT=openai/gpt-oss-120b
