{
  "name": "histopath-companion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "node prisma/seed.js",
    "test": "vitest run",
    "actions:list": "node scripts/list-actions.mjs",
    "security:audit": "npm audit --audit-level=high",
    "security:secrets": "node scripts/secret-scan.mjs"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "argon2": "0.45.1",
    "bcryptjs": "3.0.3",
    "docx": "9.13.0",
    "mammoth": "1.13.0",
    "next": "14.2.15",
    "prisma": "5.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.6.1",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "8.5.29",
    "prettier": "3.9.10",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
